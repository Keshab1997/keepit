{
  "manifest_version": 3,
  "name": "KeepIt - Smart Visual Bookmarks & Second Brain",
  "version": "1.1.0",
  "description": "Save reels, articles, tweets, quotes, and visual inspiration to your KeepIt mind with 1-click.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "notifications",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save to KeepIt"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save_current_page": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Quick save current page to KeepIt"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
