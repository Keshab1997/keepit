{
  "manifest_version": 3,
  "name": "KeepIt - Smart Visual Bookmarks & Second Brain",
  "version": "1.2.0",
  "description": "Save Instagram Reels, articles, quotes, and ideas to KeepIt. Open your library with a shortcut.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "notifications",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save to KeepIt"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save_current_page": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Quick save current page to KeepIt"
    },
    "open_keepit_web": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Open the KeepIt web library"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
