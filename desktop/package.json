{
  "name": "keepit-desktop",
  "version": "1.0.4",
  "private": true,
  "description": "Self-contained KeepIt desktop app with bundled Next.js server",
  "main": "main.cjs",
  "scripts": {
    "build:web": "npm --prefix ../web-app ci && npm --prefix ../web-app run build && node scripts/prepare-web.cjs",
    "start": "node scripts/prepare-web.cjs && electron .",
    "dist:win": "npm run build:web && electron-builder --win nsis --x64",
    "dist:mac": "npm run build:web && electron-builder --mac dmg --x64 --arm64",
    "dist": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.keshab.keepit",
    "productName": "KeepIt",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "KeepIt-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KeepIt"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "KeepIt-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "KeepIt ${version}",
      "artifactName": "KeepIt-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "../web-app/.next/standalone",
        "to": "next-server"
      },
      {
        "from": "../web-app/.next/standalone/runtime-deps",
        "to": "next-server/runtime-deps"
      }
    ]
  }
}
